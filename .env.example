# E.R.I.C. Environment Configuration
# Copy to .env and fill in your values:
#   cp .env.example .env
#   nano .env

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Create a new bot via @BotFather in Telegram
ERIC_BOT_TOKEN=your_eric_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ─── Serial (Waveshare ESP32) ─────────────────────────────────────────────────
# Jetson Orin Nano UART to ESP32
# Check with: ls /dev/ttyTHS*
SERIAL_PORT=/dev/ttyTHS1

# ─── Cameras ──────────────────────────────────────────────────────────────────
# Check with: python3 -c "import cv2; [print(i, cv2.VideoCapture(i).read()[0]) for i in range(3)]"
CAMERA_WEBCAM=0
CAMERA_PANTILT=1

# ─── Gradio UI ────────────────────────────────────────────────────────────────
GRADIO_PORT=7860
GRADIO_HOST=0.0.0.0
# Access at: http://JETSON_IP:7860

# ─── Optional: Nav2 + LiDAR + OAK-D ───────────────────────────────────────────
# Set true after starting ROS2
USE_NAV2=false
USE_LIDAR=false
USE_OAKD=false
LIDAR_STOP_DIST=0.30
LIDAR_SLOW_DIST=0.60
